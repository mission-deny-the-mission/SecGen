# Hackerbot 3 service environment (EnvironmentFile for hackerbot2.service / hackerbot3.service).
# Values below match the two-Spark layout from the Spark report (vLLM v0.28.0):
#   .65 (10.1.1.65): fast :8000  demo :8001  embed :8002  rerank :8003
#   .66 (10.1.1.66): smart :8000 clef :8001

# LLM fallback (OpenAI-compatible). Use 'fast' for chat latency, or 'smart' (10.1.1.66:8000, qwen3.8-27b) for quality.
HB2_LLM_PROVIDER=openai
HB2_OPENAI_BASE_URL=http://10.1.1.65:8000/v1
HB2_LLM_MODEL=qwen3.6-35b-a3b
HB2_OPENAI_API_KEY=none
HB2_EMBEDDING_MODEL=qwen3-embedding

# Canned-response decision router (see decision/README.md)
HB3_DECISION_URL=http://10.1.1.66:8001
HB3_DECISION_MODEL=clef-flash
HB3_DECISION_STRATEGY=twopass
HB3_DECISION_THRESHOLD=0.5
HB3_DECISION_SHORTLIST_K=8
HB3_EMBED_URL=http://10.1.1.65:8002
HB3_EMBED_MODEL=qwen3-embedding
HB3_DECISION_TIMEOUT=4
# HB3_DECISION_LOG=/var/log/hackerbot/decisions.jsonl   # stores student messages: only with students' knowledge

no_proxy=localhost,127.0.0.1,10.0.0.0/8
NO_PROXY=localhost,127.0.0.1,10.0.0.0/8
