<?xml version='1.0' encoding='UTF-8' ?>

<purple version='1.0'>
	<blist>
		<group>
			<setting name='collapsed' type='bool'>0</setting>
<% @buddies.each do |buddy| -%>
			<contact>
				<buddy account='<%=@username-%>@<%=@ip%>' proto='prpl-irc'>
					<name><%= buddy %></name>
				</buddy>
<% if buddy == 'Hackerbot' -%>
				<setting name="custom_buddy_icon" type="string">skullandusb.svg</setting>
<% end -%>
			</contact>
<% end -%>
		</group>
	</blist>
	<privacy>
		<account proto='prpl-irc' name='<%=@username-%>@<%=@ip%>' mode='4'>
				<block>irc.localhost</block>
		</account>
	</privacy>
</purple>
