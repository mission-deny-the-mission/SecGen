# ResourceQuota for a lab namespace created by SecGen (--kubevirt-create-namespace).
# Generated by SecGen -- fix lib/templates/kubevirt_namespace_quota.yaml.erb, not this file.
#
# Deliberately a storage/count quota only: KubeVirt's virt-launcher pods do not always
# carry CPU/memory resource requests, and a quota asking for them makes pod admission
# fail for every VM in the namespace. Add requests.cpu / requests.memory here only after
# checking that your cluster gives virt-launcher pods those requests.
#
# A lab VM's disk is a full clone of the golden image, so labs are storage-hungry:
# raise persistentvolumeclaims / requests.storage (or delete this quota) for big labs.
apiVersion: v1
kind: ResourceQuota
metadata:
  name: secgen-lab-quota
  namespace: <%= namespace %>
spec:
  hard:
    persistentvolumeclaims: "20"
    requests.storage: 1Ti
