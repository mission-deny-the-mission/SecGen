# Egress tier for the KubeVirt lab in namespace <%= namespace %>.
# Generated by SecGen -- fix lib/templates/kubevirt_egress_cnp.yaml.erb, not this file.
#
# Applied only for --kubevirt-egress litellm|none, and only AFTER provisioning: the build
# itself needs open egress (apt, downloads), so locking the lab down first breaks it.
#
# It selects the lab VMs by label (secgen.io/lab-vm), which the VM template puts on the
# virt-launcher pod. The policy is evaluated for that pod, i.e. for everything the guest sends
# out of the masquerade interface. Traffic on a Multus lab network does not pass Cilium at all,
# so these tiers never restrict a lab network -- only the pod network.
#
# Why the 'litellm' tier looks like this (all measured from a booted masquerade guest):
#   * A KubeVirt masquerade guest CANNOT reach ClusterIP services (CoreDNS at 10.96.0.10:53
#     answers "No route to host", the LiteLLM ClusterIP connection fails) and CANNOT complete a
#     service connection whose path stays on, or returns via, ITS OWN node. So the LAN-side
#     address of the proxy (the MetalLB VIP) also fails from a guest.
#   * It CAN reach any OTHER node's IP on a NodePort. Measured: same guest, same policy --
#     http://<other node>:30400 returned 200 while http://<its own node>:30400 timed out.
#     Hence the allowed destinations are node identities (host/remote-node), not pod endpoints
#     or a ClusterIP, and SecGen picks a node IP that is not the VM's own node.
#   * There is no DNS in this tier except the resolver the guest was configured with (public
#     by default), so the LiteLLM endpoint is given to the guest as a hosts entry
#     (litellm.lab) rather than a name that needs resolving.
#   * Cilium replaces the whole egress policy of a selected endpoint: an allow-list, so
#     everything not listed is denied (the deny is confirmed by "action deny, match none" in
#     cilium-dbg monitor and by internet/registry access failing from the guest).
#   * Propagation to the datapath took about a minute in testing, and traffic kept flowing
#     until then, so SecGen re-checks the lane from inside the guest after applying this and
#     waits for it before reporting success.
#
# A note on the 'none' tier: Cilium rejects a policy whose rule list is empty ("rule must have
# at least one of Ingress, IngressDeny, Egress, EgressDeny" -- verified: traffic kept flowing),
# so "no egress at all" is expressed as an allow-list that matches nothing routable: TEST-NET-1
# (RFC 5737, never routed anywhere). Verified from a guest: internet, every node's NodePort and
# DNS all fail.
apiVersion: cilium.io/v2
kind: CiliumNetworkPolicy
metadata:
  name: secgen-lab-egress
  namespace: <%= namespace %>
  labels:
    app.kubernetes.io/part-of: secgen
    secgen.io/role: lab-egress
spec:
  endpointSelector:
    matchLabels:
      secgen.io/lab-vm: "true"
  egress:
<% if egress_tier == 'litellm' -%>
    # the LLM lane: the LiteLLM NodePort on any node (a node that is not the guest's own node
    # is what actually answers; the policy cannot say "not my node", so it allows all nodes)
    - toEntities:
        - host
        - remote-node
      toPorts:
        - ports:
            - port: "<%= egress_port %>"
              protocol: TCP
<% if egress_dns_servers.any? -%>
    # name resolution, for the resolver handed to the guest only (the cluster's DNS is
    # unreachable from a masquerade guest, so this is the --kubevirt-dns resolver)
    - toCIDR:
<% egress_dns_servers.each do |server| -%>
        - <%= server %>/32
<% end -%>
      toPorts:
        - ports:
            - port: "53"
              protocol: ANY
<% end -%>
<% else -%>
    # TEST-NET-1 (RFC 5737): documentation-only, never routed -- an allow-list that permits
    # nothing reachable, i.e. no egress at all.
    - toCIDR:
        - 192.0.2.0/24
<% end -%>
