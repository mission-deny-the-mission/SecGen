# SecGen KubeVirt VM manifest for the system "<%= system_name %>" (VM "<%= vm_name %>").
# Generated by SecGen -- fix lib/templates/kubevirt_vm.yaml.erb, not this file.
#
# Networking: the guest always has a masquerade interface on the cluster pod network, which is
# how SecGen reaches it (virtctl ssh/scp/port-forward over the API server) and the only way it
# gets a default route. Each scenario <network> adds a Multus bridge interface on the lab's own
# L2 segment (lib/templates/kubevirt_nad.yaml.erb); the NADs are applied before this manifest.
# See "Networking" in README-KubeVirt.md.
apiVersion: kubevirt.io/v1
kind: VirtualMachine
metadata:
  name: <%= vm_name %>
  labels:
    app.kubernetes.io/part-of: secgen
    secgen.io/role: lab-vm
spec:
  runStrategy: Always
  dataVolumeTemplates:
    - metadata:
        name: <%= vm_name %>-root
      spec:
        source:
          pvc:
            # Golden image: the base box, kept as a PVC in its own namespace and cloned
            # (never modified) for each lab VM.
            name: <%= golden_image %>
            namespace: <%= golden_namespace %>
        storage:
          storageClassName: <%= storage_class %>
          accessModes:
            - ReadWriteOnce
          resources:
            requests:
              # At least the golden image's own size, read from the cluster when the
              # project was generated (--kubevirt-image-size overrides).
              storage: <%= disk_size %>
  template:
    metadata:
<% ovn_interfaces = lab_interfaces.select { |interface| interface['provider'] } -%>
<% if ovn_interfaces.any? -%>
      # Kube-OVN lab networks: pin each lab interface to the address SecGen assigned it. The
      # annotation is per provider (one per lab network); KubeVirt's DHCP hands it to the guest.
      annotations:
<% ovn_interfaces.each do |interface| -%>
        <%= interface['provider'] %>.kubernetes.io/ip_address: "<%= interface['address'] %>"
<% end -%>
<% end -%>
      labels:
        kubevirt.io/domain: <%= vm_name %>
        app.kubernetes.io/part-of: secgen
        # Consumed by the lab's CiliumNetworkPolicy (the egress tier) and by the placement
        # constraints below. It has to be on the *template*: the policy selects the
        # virt-launcher pod, not the VirtualMachine object.
        secgen.io/lab-vm: "true"
        secgen.io/lab: "<%= lab_id %>"
    spec:
      # A masquerade guest is handed the virt-launcher pod's resolv.conf over DHCP. With
      # the default policy that is the cluster's DNS (CoreDNS ClusterIP) and with
      # "Default" it is the node's resolver -- NEITHER is reachable from the guest, so
      # package installation in every puppet module would fail. Verified fix: dnsPolicy
      # None plus an explicit nameserver below, which the guest then receives verbatim.
      # --kubevirt-dns overrides the resolver (e.g. point labs at your own DNS).
      dnsPolicy: <%= dns_policy %>
<% if dns_nameservers.any? -%>
      dnsConfig:
        nameservers:
<% dns_nameservers.each do |nameserver| -%>
          - <%= nameserver %>
<% end -%>
<% end -%>
<% if placement == 'compact' -%>
      # --kubevirt-placement compact: keep the whole lab on one node (needed on the bridge
      # backend, whose Multus bridges are node-local (a bridge in one node's network namespace cannot see another
      # node's). Required affinity, so the lab fails to schedule rather than silently coming up
      # with its VMs unable to reach each other on their lab networks.
      affinity:
        podAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            - topologyKey: kubernetes.io/hostname
              labelSelector:
                matchLabels:
                  secgen.io/lab: "<%= lab_id %>"
<% elsif placement == 'spread' -%>
      # Default: spread the lab's VMs over the cluster's nodes, so a lab whose VMs do not all
      # fit on one node can still be built. whenUnsatisfiable ScheduleAnyway, not
      # DoNotSchedule: a node with no room must not make the whole lab unschedulable.
      # On the Kube-OVN backend the lab networks span the nodes, so spreading costs nothing.
      # On the bridge backend lab networks only reach VMs on the same node (README-KubeVirt.md),
      # so a spread lab loses cross-VM connectivity there (use --kubevirt-placement compact).
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: ScheduleAnyway
          labelSelector:
            matchLabels:
              secgen.io/lab: "<%= lab_id %>"
<% else -%>
      # --kubevirt-placement <node>: pin the lab to one named node (node-local lab networks,
      # and a predictable placement for debugging).
      nodeSelector:
        kubernetes.io/hostname: "<%= placement %>"
<% end -%>
      domain:
        machine:
          type: q35
        cpu:
          cores: <%= cpus %>
        memory:
          guest: <%= memory %>Mi
        devices:
          disks:
            - name: root
              disk:
                bus: virtio
            - name: cloudinit
              disk:
                bus: virtio
          interfaces:
            - name: default
              masquerade: {}
<% lab_interfaces.each do |interface| -%>
            # <%= interface['comment'] %>
            - name: <%= interface['name'] %>
              bridge: {}
<% end -%>
      networks:
        - name: default
          pod: {}
<% lab_interfaces.each do |interface| -%>
        - name: <%= interface['name'] %>
          multus:
            networkName: <%= interface['nad_namespace'] %>/<%= interface['nad'] %>
<% end -%>
      volumes:
        - name: root
          dataVolume:
            name: <%= vm_name %>-root
        - name: cloudinit
          cloudInitNoCloud:
            userData: |
              #cloud-config
              # Informational only: the published SecGen bases have already consumed
              # their cloud-init instance state, so this does not run. The provisioning
              # script sets the hostname itself (hostnamectl + /etc/hosts).
              hostname: <%= hostname %>
              fqdn: <%= hostname %>
              preserve_hostname: false
