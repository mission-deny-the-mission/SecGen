# SecGen KubeVirt VM manifest for the system "<%= system_name %>" (VM "<%= vm_name %>").
# Generated by SecGen -- fix lib/templates/kubevirt_vm.yaml.erb, not this file.
#
# PHASE 1 SCOPE: networking is pod/masquerade only. The guest has an address on the
# cluster pod network, and is reached through the API server (virtctl ssh/scp/port-forward).
# Scenario modules that expect a static IP on an isolated L2 network or VLAN are not
# supported yet (that needs Multus; phase 2) -- see README-KubeVirt.md.
apiVersion: kubevirt.io/v1
kind: VirtualMachine
metadata:
  name: <%= vm_name %>
  labels:
    app.kubernetes.io/part-of: secgen
    secgen.io/role: lab-vm
spec:
  runStrategy: Always
  dataVolumeTemplates:
    - metadata:
        name: <%= vm_name %>-root
      spec:
        source:
          pvc:
            # Golden image: the base box, kept as a PVC in its own namespace and cloned
            # (never modified) for each lab VM.
            name: <%= golden_image %>
            namespace: <%= golden_namespace %>
        storage:
          storageClassName: <%= storage_class %>
          accessModes:
            - ReadWriteOnce
          resources:
            requests:
              # At least the golden image's own size, read from the cluster when the
              # project was generated (--kubevirt-image-size overrides).
              storage: <%= disk_size %>
  template:
    metadata:
      labels:
        kubevirt.io/domain: <%= vm_name %>
        app.kubernetes.io/part-of: secgen
    spec:
      # A masquerade guest is handed the virt-launcher pod's resolv.conf over DHCP. With
      # the default policy that is the cluster's DNS (CoreDNS ClusterIP) and with
      # "Default" it is the node's resolver -- NEITHER is reachable from the guest, so
      # package installation in every puppet module would fail. Verified fix: dnsPolicy
      # None plus an explicit nameserver below, which the guest then receives verbatim.
      # --kubevirt-dns overrides the resolver (e.g. point labs at your own DNS).
      dnsPolicy: <%= dns_policy %>
<% if dns_nameservers.any? -%>
      dnsConfig:
        nameservers:
<% dns_nameservers.each do |nameserver| -%>
          - <%= nameserver %>
<% end -%>
<% end -%>
      domain:
        machine:
          type: q35
        cpu:
          cores: <%= cpus %>
        memory:
          guest: <%= memory %>Mi
        devices:
          disks:
            - name: root
              disk:
                bus: virtio
            - name: cloudinit
              disk:
                bus: virtio
          interfaces:
            - name: default
              masquerade: {}
      networks:
        - name: default
          pod: {}
      volumes:
        - name: root
          dataVolume:
            name: <%= vm_name %>-root
        - name: cloudinit
          cloudInitNoCloud:
            userData: |
              #cloud-config
              # Informational only: the published SecGen bases have already consumed
              # their cloud-init instance state, so this does not run. The provisioning
              # script sets the hostname itself (hostnamectl + /etc/hosts).
              hostname: <%= hostname %>
              fqdn: <%= hostname %>
              preserve_hostname: false
