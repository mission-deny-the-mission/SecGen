#!/bin/bash
# SecGen provisioning script for the system "<%= system_name %>" (KubeVirt VM "<%= vm_name %>").
# Generated by SecGen -- fix lib/templates/kubevirt_provision.sh.erb, not this file.
#
# Runs inside the guest as the vagrant user (which has passwordless sudo), pushed and
# invoked over virtctl by lib/helpers/kubevirt.rb. It mirrors the puppet provisioning
# blocks of the Vagrant provider (lib/templates/Vagrantfile.erb), in the scenario's
# module order, with the same module_path / environment_path / facter inputs.
#
# The order of the steps matters:
#   1. hostname  - cloud-init is inert on the published bases, so the hostname is set
#                  here, before anything that resolves it (a sudo command run while the
#                  hostname is unresolved prints a warning).
#   2. resolver  - KubeVirt hands a masquerade guest the virt-launcher pod's resolv.conf.
#                  With the default policy that is the cluster DNS (CoreDNS ClusterIP) and
#                  with dnsPolicy Default it is the node's resolver -- the guest can reach
#                  NEITHER. The VM is therefore created with dnsPolicy None plus an
#                  explicit nameserver (--kubevirt-dns overrides which), and this step
#                  writes the same resolver into the guest as a belt-and-braces measure so
#                  provisioning cannot depend on the DHCP handoff alone.
#   3. puppet    - one puppet apply per selected module.
#
# Phase 1 has no isolated-L2/VLAN networking: the guest only has an address on the
# cluster pod network (see README-KubeVirt.md).
set -uo pipefail

PUPPET_ROOT="<%= puppet_root %>"
PUPPET_SYSTEM="<%= puppet_system_dir %>"

echo "== SecGen: provisioning '<%= system_name %>' (host '<%= hostname %>')"

echo "== 1. hostname"
# Update /etc/hosts BEFORE renaming: once the hostname changes, every sudo call warns
# "unable to resolve host" until 127.0.1.1 names it (seen on the Kali base, whose
# /etc/hosts has no 127.0.1.1 line at all).
sudo sed -i "s/^127\.0\.1\.1.*/127.0.1.1\t<%= hostname %>/" /etc/hosts
grep -q "^127\.0\.1\.1" /etc/hosts || printf '127.0.1.1\t<%= hostname %>\n' | sudo tee -a /etc/hosts >/dev/null
sudo hostnamectl set-hostname "<%= hostname %>" 2>/dev/null || sudo hostname "<%= hostname %>"
echo "   hostname: $(hostname)"

echo "== 2. resolver"
<% if dns_nameservers.any? -%>
# --kubevirt-dns: the guest cannot reach the cluster's DNS, so give it nameservers it can.
sudo sh -c 'printf "<%= dns_nameservers.map { |nameserver| "nameserver #{nameserver}\\n" }.join %>" > /etc/resolv.conf'
<% end -%>
if getent hosts deb.debian.org >/dev/null 2>&1; then
  echo "   DNS resolution OK"
else
  echo "   WARNING: the guest cannot resolve names: puppet modules that install packages will fail"
  echo "   (see 'Guest DNS' in README-KubeVirt.md)"
fi

echo "== 3. puppet modules (<%= modules.size %>)"
# Locate puppet rather than assume /usr/bin/puppet: the Debian base ships it there, but the
# Kali base has it elsewhere (found on the first real two-VM build: "env: '/usr/bin/puppet':
# No such file or directory"). sudo's secure_path can also differ from the login PATH, so
# search the usual install locations explicitly.
PUPPET=""
for candidate in "$(command -v puppet 2>/dev/null)" /usr/bin/puppet /usr/local/bin/puppet \
                 /opt/puppetlabs/bin/puppet /opt/puppetlabs/puppet/bin/puppet; do
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then PUPPET="$candidate"; break; fi
done
if [ -z "$PUPPET" ]; then
  PUPPET="$(sudo sh -c 'command -v puppet' 2>/dev/null || true)"
fi
if [ -z "$PUPPET" ]; then
  echo "FAILED: no puppet binary found in the guest (looked on PATH and in the usual locations)"
  exit 127
fi
echo "   puppet: $PUPPET ($("$PUPPET" --version 2>/dev/null || echo unknown version))"
<% modules.each do |mod| -%>
echo "-- module: <%= mod['path'] %>"
<% if mod['inputs_file'] -%>
sudo env RUBYOPT=-W0 FACTER_base64_inputs_file="<%= mod['inputs_file'] %>" \
  "$PUPPET" apply --detailed-exitcodes \
  --modulepath="$PUPPET_SYSTEM/modules" \
  --environmentpath="$PUPPET_ROOT/environments" \
  --environment=production \
  "$PUPPET_SYSTEM/modules/<%= mod['path_end'] %>/<%= mod['path_end'] %>.pp"
<% else -%>
sudo env RUBYOPT=-W0 \
  "$PUPPET" apply --detailed-exitcodes \
  --modulepath="$PUPPET_SYSTEM/modules" \
  --environmentpath="$PUPPET_ROOT/environments" \
  --environment=production \
  "$PUPPET_SYSTEM/modules/<%= mod['path_end'] %>/<%= mod['path_end'] %>.pp"
<% end -%>
rc=$?
# --detailed-exitcodes: 0 = no changes, 2 = changes applied, 1 = error, 4/6 = failures
if [ "$rc" -ne 0 ] && [ "$rc" -ne 2 ]; then
  echo "FAILED: puppet apply for <%= mod['path'] %> exited $rc"
  exit "$rc"
fi
<% end -%>

echo "== SecGen: provisioning of '<%= system_name %>' finished"
