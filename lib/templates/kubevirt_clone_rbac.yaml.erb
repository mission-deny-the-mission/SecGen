# Cross-namespace clone access for a lab namespace created by SecGen
# (--kubevirt-create-namespace).
# Generated by SecGen -- fix lib/templates/kubevirt_clone_rbac.yaml.erb, not this file.
#
# CDI authorises a cross-namespace PVC clone as the DataVolume's creator, so the *lab*
# namespace's service accounts need 'create' on datavolumes/source in the namespace that
# holds the golden images. Without this, creating a VM fails with:
#   User system:serviceaccount:<%= namespace %>:default has insufficient permissions
#   in clone source namespace <%= golden_namespace %>
#
# Both objects belong to the golden-image namespace, not the lab namespace. Applying this
# needs permission to create roles and rolebindings in <%= golden_namespace %> (on a
# GitOps-managed cluster that namespace may be managed elsewhere -- see README-KubeVirt.md).
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: secgen-clone-source
  namespace: <%= golden_namespace %>
rules:
  - apiGroups: ["cdi.kubevirt.io"]
    resources: ["datavolumes/source"]
    verbs: ["create"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: secgen-clone-source-<%= namespace %>
  namespace: <%= golden_namespace %>
subjects:
  - kind: Group
    name: system:serviceaccounts:<%= namespace %>
    apiGroup: rbac.authorization.k8s.io
roleRef:
  kind: Role
  name: secgen-clone-source
  apiGroup: rbac.authorization.k8s.io
