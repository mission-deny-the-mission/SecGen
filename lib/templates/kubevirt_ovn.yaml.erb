# Lab networks for the KubeVirt lab in namespace <%= namespace %> (Kube-OVN backend).
# Generated by SecGen -- fix lib/templates/kubevirt_ovn.yaml.erb, not this file.
#
# One scenario VLAN = one Kube-OVN Vpc + Subnet + NetworkAttachmentDefinition. The Subnet is an
# OVN logical switch that spans every node (Geneve tunnels between the nodes), so a lab's VMs
# share their L2 segment wherever they are scheduled -- unlike the node-local `bridge` backend.
#
# Shape (Kube-OVN v1.16 as a secondary network through Multus, beside any primary CNI):
#   * Each network gets a Vpc of its own. A Vpc is an OVN logical router, and Kube-OVN only
#     checks CIDR overlap inside one Vpc, so two labs (or two networks of one lab) may use the
#     same subnet at the same time and never see each other (measured: two labs both on
#     one /24 with the same address, 100% loss between them, 0% inside each).
#     Nothing routes a lab Vpc to the cluster or to another Vpc.
#   * A guest's address is pinned per interface with the pod annotation
#     <provider>.kubernetes.io/ip_address on the VM template (kubevirt_vm.yaml.erb); KubeVirt's
#     DHCP then hands that address to the guest, MTU included (Kube-OVN's default, 1400:
#     a 1500-byte node network less the Geneve overhead), and no router/gateway
#     (verified: the offer carries ip, subnet, dns and mtu only).
#   * The Subnet's gateway is an address the scenario does not use; it only exists on the
#     Vpc's router port and is never handed to a guest.
<% nad_networks.each do |net| -%>
---
# <%= net['comment'] %>
apiVersion: kubeovn.io/v1
kind: Vpc
metadata:
  name: <%= net['vpc'] %>
  labels:
    app.kubernetes.io/part-of: secgen
    secgen.io/role: lab-network
    secgen.io/owner: secgen-provider
    secgen.io/lab-namespace: <%= namespace %>
spec:
  namespaces: [<%= namespace %>]
---
apiVersion: kubeovn.io/v1
kind: Subnet
metadata:
  name: <%= net['subnet'] %>
  labels:
    app.kubernetes.io/part-of: secgen
    secgen.io/role: lab-network
    secgen.io/owner: secgen-provider
    secgen.io/lab-namespace: <%= namespace %>
spec:
  vpc: <%= net['vpc'] %>
  namespaces: [<%= namespace %>]
  protocol: IPv4
  cidrBlock: <%= net['range'] %>
  gateway: <%= net['gateway'] %>
  excludeIps: [<%= net['gateway'] %>]
  provider: <%= net['provider'] %>
  enableDHCP: false
---
apiVersion: k8s.cni.cncf.io/v1
kind: NetworkAttachmentDefinition
metadata:
  name: <%= net['name'] %>
  namespace: <%= namespace %>
  labels:
    app.kubernetes.io/part-of: secgen
    secgen.io/role: lab-network
    secgen.io/owner: secgen-provider
spec:
  config: '{"cniVersion": "0.3.1", "type": "kube-ovn", "server_socket": "/run/openvswitch/kube-ovn-daemon.sock", "provider": "<%= net['provider'] %>"}'
<% end -%>
